@REM ----------------------------------------------------------------------------
@REM Maven Start Up Batch script for Windows CMD / PowerShell (Module Subdirectory)
@REM ----------------------------------------------------------------------------

@IF "%DEBUG%" == "" @ECHO OFF
IF EXIST "%~dp0..\mvnw.cmd" (
  "%~dp0..\mvnw.cmd" %*
) ELSE (
  echo Error: Root mvnw.cmd not found.
  exit /b 1
)
